# Copy to .env and fill in. Never commit .env.

# Ledger backend: "csv" (demo, default) or "sheets"
LEDGER_BACKEND=csv
LEDGER_CSV_DIR=data/sample

# Google Sheets backend
GOOGLE_SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Claude vision for the photo-to-verdict agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Where proposed changes wait for approval
APPROVAL_QUEUE=~/.ecom_agent/pending.json
